VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase is now the primary DB (weddings + photos). Guest QR/links are /w/{slug}, isolated per wedding.
# Images still save to Google Drive by default via the Edge Function — no GAS needed.
# --- Legacy / fallback (you can now delete your Apps Script) ---
VITE_GAS_WEBHOOK_URL=
# Optional shared secret — if set, also set GAS_TOKEN in your Apps Script Properties
VITE_GAS_TOKEN=
# Used for <link rel="canonical"> and QR codes when deployed (e.g. https://kendraanddiego.me)
VITE_SITE_URL=
# --- Edge Function only (set in Supabase Dashboard > Edge Functions > Secrets, NOT as VITE_ ) ---
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are auto-provided to the function.
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}  (paste JSON string)
# DRIVE_PARENT_FOLDER_ID=1a2b3c... (Drive folder ID shared with service account)
